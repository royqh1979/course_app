# Composer 依赖（composer.lock 作为应用需提交，保证部署可复现）
# 仅忽略仓库根目录的 vendor/，不忽略 public/assets/vendor/（本地化前端库需提交）
/vendor/

# 私有上传文件与临时文件（禁止入库）
storage/
public/assets/uploads/

# 本地敏感配置
config/*.local.php
.env
.env.*

# 日志与测试缓存
*.log
.phpunit.cache/
.phpunit.result.cache

# IDE / 系统杂项
.idea/
.vscode/
Thumbs.db
.DS_Store
